# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/avd360?retryWrites=true&w=majority"

# ---- Email notifications (optional) ----
# The contact API will notify the team when a form is submitted.
# If these are not set, email notification is skipped cleanly and the
# submission is still saved to MongoDB.

# Resend (recommended for Next.js) — https://resend.com
RESEND_API_KEY=""
# Address that receives contact notifications
CONTACT_NOTIFY_TO="jainishpatel772@gmail.com"
# Verified "from" address on your Resend domain (falls back to onboarding@resend.dev)
CONTACT_NOTIFY_FROM="AVD 360 Solution <onboarding@resend.dev>"

# Simple token to protect GET /api/contact (future admin use)
ADMIN_API_TOKEN=""

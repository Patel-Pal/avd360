# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/avd360?retryWrites=true&w=majority"

# ---- Email notifications (optional) ----
# The contact API notifies the team AND sends the visitor an auto-reply.
# The newsletter API sends a welcome email to new subscribers.
# If RESEND_API_KEY is not set, all email is skipped cleanly and data is
# still saved to MongoDB.

# Resend (recommended for Next.js) — https://resend.com
RESEND_API_KEY=""

# Default "from" for ALL outgoing mail. Use YOUR OWN verified Resend domain
# (a different domain than any other project). Must be verified in Resend to
# reach arbitrary recipients and to send the visitor auto-reply reliably.
# Format: "Display Name <address@yourdomain.com>"
EMAIL_FROM="AVD 360 Solution <noreply@yourdomain.com>"

# Public site origin — used for the logo image and links inside emails.
# Must be a live, publicly reachable URL (email clients can't load local paths).
# No trailing slash. The logo is loaded from `${SITE_URL}/logo.jpeg`.
SITE_URL="https://yourdomain.com"

# Address that receives contact enquiries (internal inbox)
CONTACT_NOTIFY_TO="jainishpatel772@gmail.com"

# Optional per-message "from" overrides (all fall back to EMAIL_FROM)
CONTACT_NOTIFY_FROM=""
CONTACT_REPLY_FROM=""
NEWSLETTER_FROM=""

# Simple token to protect GET /api/contact (future admin use)
ADMIN_API_TOKEN=""
